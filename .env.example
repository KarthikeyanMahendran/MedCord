# Copy to .env and fill in. NEVER commit .env.

# --- PostgreSQL (local, port 5432) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medcord
DB_USER=medcord_app
DB_PASSWORD=change-me

# --- Auth ---
JWT_SECRET=change-me-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# --- Nexconn (console: App Key page) ---
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Region of your console app: https://api.sg-light-api.com | https://api.us-light-api.com | https://api.sau-light-api.com
NEXCONN_API_BASE_URL=
NEXCONN_WEBHOOK_SECRET=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_NEXCONN_APP_KEY=
